import React from "react";
import { useAPI } from "./App";
import { EditorProvider } from "./editor/EditorContext";
import { Toolbar } from "./editor/Toolbar";
import { HierarchyPanel } from "./editor/HierarchyPanel";
import { InspectorPanel } from "./editor/InspectorPanel";

export default function EditorHUD() {
  const api = useAPI();
  const ctx = api.ecsWorld;

  return (
    <EditorProvider engine={api} ctx={ctx}>
      <div style={{ pointerEvents: 'none', width: '100%', height: '100%', position: 'relative' }}>
        <Toolbar />
        <HierarchyPanel />
        <InspectorPanel />
      </div>
    </EditorProvider>
  );
}

// Legacy export for backward compatibility
export function LegacyEditorHUD() {
  const api = useAPI();

  useEffect(() => {
    const ctx = api.ecsWorld;
    let frameId: number;

    const updateSelection = () => {
      const selected = getResource<number | undefined>(ctx, 'selectedEntity', true);
      setSelectedEntity(selected);

      if (selected !== undefined) {
        // Get entity name
        const name = hasComponent(ctx, Info, selected)
          ? decode(Info.name[selected])
          : `Entity #${selected}`;
        setEntityName(name);

        // Get entity bundle
        try {
          const bundle = getEntityBundle(ctx, selected);
          setEntityBundle(JSON.stringify(bundle, null, 2));
        } catch (e) {
          setEntityBundle("Error serializing entity");
        }
      } else {
        setEntityName("");
        setEntityBundle("");
      }

      frameId = requestAnimationFrame(updateSelection);
    };

    updateSelection();

    return () => {
      if (frameId) cancelAnimationFrame(frameId);
    };
  }, [api]);

  const copyBundleToClipboard = async () => {
    if (entityBundle) {
      try {
        await navigator.clipboard.writeText(entityBundle);
        console.log("Bundle copied to clipboard");
      } catch (err) {
        console.error("Failed to copy bundle:", err);
      }
    }
  };

  const exportScene = () => {
    const ctx = api.ecsWorld;
    // Get all entities and their bundles
    const entities: any[] = [];
    const renderObjects = getResource<Map<number, THREE.Object3D>>(ctx, 'renderObjects');
    
    if (renderObjects) {
      renderObjects.forEach((_, eid) => {
        try {
          const bundle = getEntityBundle(ctx, eid);
          entities.push(bundle);
        } catch (e) {
          console.error(`Failed to serialize entity ${eid}:`, e);
        }
      });
    }

    // Create scene export data
    const metadata = getResource(ctx, 'metadata');
    const sceneData = {
      metadata: metadata || {},
      entities,
      timestamp: new Date().toISOString(),
    };

    // Convert to JavaScript file format
    const jsContent = `// Scene exported from AI Game Engine
// Timestamp: ${sceneData.timestamp}

export default {
  setupScene(api) {
    // Scene metadata
    const metadata = ${JSON.stringify(sceneData.metadata, null, 2)};
    api.setResource('metadata', metadata);

    // Spawn entities
    const entities = ${JSON.stringify(entities, null, 2)};
    
    entities.forEach(bundle => {
      api.spawn(bundle);
    });
  }
};
`;

    // Create blob and download
    const blob = new Blob([jsContent], { type: 'application/javascript' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `scene-${Date.now()}.js`;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
    
    console.log("Scene exported successfully");
  };

  return (
    <div style={{ pointerEvents: 'none', width: '100%', height: '100%', position: 'relative' }}>
      {/* Export scene button - always visible */}
      <div style={{
        position: 'absolute',
        top: '20px',
        left: '50%',
        transform: 'translateX(-50%)',
        pointerEvents: 'auto',
      }}>
        <Button
          type="primary"
          icon={<ExportOutlined />}
          onClick={exportScene}
          size="large"
        >
          Export Scene
        </Button>
      </div>

      {/* Help text in bottom-left */}
      <div style={{
        position: 'absolute',
        bottom: '20px',
        left: '20px',
        background: 'rgba(0,0,0,0.7)',
        padding: '12px',
        borderRadius: '8px',
        pointerEvents: 'auto',
        fontSize: '12px',
      }}>
        <Text style={{ color: '#fff', display: 'block', marginBottom: '4px', fontWeight: 'bold' }}>
          Editor Controls
        </Text>
        <Text style={{ color: '#aaa', display: 'block' }}>
          WASD: Move camera (XZ plane)
        </Text>
        <Text style={{ color: '#aaa', display: 'block' }}>
          E: Move up
        </Text>
        <Text style={{ color: '#aaa', display: 'block' }}>
          Q: Move down
        </Text>
        <Text style={{ color: '#aaa', display: 'block' }}>
          Right Click + Drag: Rotate camera
        </Text>
        <Text style={{ color: '#aaa', display: 'block' }}>
          Left Click: Select entity
        </Text>
        <Text style={{ color: '#aaa', display: 'block' }}>
          J: Translate mode
        </Text>
        <Text style={{ color: '#aaa', display: 'block' }}>
          K: Rotate mode
        </Text>
        <Text style={{ color: '#aaa', display: 'block' }}>
          L: Scale mode
        </Text>
        <Text style={{ color: '#aaa', display: 'block' }}>
          X: Toggle local/world space
        </Text>
        <Text style={{ color: '#aaa', display: 'block' }}>
          Shift: Enable snapping
        </Text>
      </div>

      {/* Selected entity info */}
      {selectedEntity !== undefined && (
        <>
          {/* Entity name in top-left */}
          <div style={{
            position: 'absolute',
            top: '20px',
            left: '20px',
            background: 'rgba(0,0,0,0.8)',
            padding: '12px 20px',
            borderRadius: '8px',
            pointerEvents: 'auto',
          }}>
            <Text style={{ color: '#fff', fontSize: '16px', fontWeight: 'bold' }}>
              Selected: {entityName}
            </Text>
          </div>

          {/* Entity bundle in right-side pane */}
          <div style={{
            position: 'absolute',
            top: '20px',
            right: '20px',
            width: '350px',
            maxHeight: '80vh',
            background: 'rgba(0,0,0,0.9)',
            padding: '16px',
            borderRadius: '8px',
            overflowY: 'auto',
            pointerEvents: 'auto',
          }}>
            <div style={{ marginBottom: '12px', display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
              <Text style={{ color: '#fff', fontSize: '14px', fontWeight: 'bold' }}>
                Edit Object
              </Text>
              <Button
                icon={<CopyOutlined />}
                onClick={copyBundleToClipboard}
                size="small"
              >
                Copy
              </Button>
            </div>
            <pre style={{
              margin: 0,
              color: '#fff',
              fontSize: '11px',
              fontFamily: 'monospace',
              whiteSpace: 'pre-wrap',
              wordBreak: 'break-all',
            }}>
              {entityBundle}
            </pre>
          </div>
        </>
      )}
    </div>
  );
}
