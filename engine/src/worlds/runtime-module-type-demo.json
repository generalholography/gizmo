  "moduleTypes": [
    {
      "moduleName": "field",
      "typeName": "radialPulse",
      "description": "Simple radial field that returns amplitude inside a radius and zero outside.",
      "parameterSchema": {
        "type": "object",
        "properties": {
          "radius": {
            "type": "number"
          },
          "amplitude": {
            "type": "number"
          }
        }
      },
      "factorySource": "(params) => ({ sample3D(x, y, z) { const r = Math.sqrt(x * x + z * z); return r <= (params.radius ?? 1) ? (params.amplitude ?? 1) : 0; } })"
    }
  ],
  "modules": {
